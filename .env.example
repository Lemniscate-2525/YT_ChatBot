# Copy to .env for local development; never commit real credentials.

# Required Provider Keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Service-to-Service API Authentication
RAG_API_KEY=replace-with-a-long-random-secret

# Redis Rate Limiting & Infrastructure
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=2.0
GLOBAL_LIMIT=100
USER_LIMIT=10
RATE_LIMIT_WINDOW=60

# Model Configurations
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=gemini-embedding-001

# Optional Proxy Configuration (Bypass cloud IP blocks / bot gates)
# Webshare rotating residential proxy (https://www.webshare.io)
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# Or generic HTTP/HTTPS proxy URL (e.g. http://user:pass@host:port)
PROXY_URL=

# Storage Paths
CHROMA_DIR=chroma_db
KNOWLEDGE_GRAPH_PATH=data/knowledge_graph.json

# API & Security
ENABLE_API_DOCS=false
CORS_ORIGINS=*
MAX_QUERY_LENGTH=200
MAX_ANSWER_LENGTH=3000
LOG_LEVEL=INFO

# Frontend Connection (Streamlit app.py)
RAG_API_URL=http://localhost:8000
